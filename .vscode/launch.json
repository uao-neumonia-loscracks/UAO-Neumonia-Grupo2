{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Detector Neumonía (GUI)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/detector_neumonia.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "env": {
                "MODEL_PATH": "${workspaceFolder}/models/conv_MLP_84.h5",
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Pytest (archivo actual)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}"],
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}"
        }
    ]
}

